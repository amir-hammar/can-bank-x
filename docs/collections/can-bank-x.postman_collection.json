    {
      "name": "CU-03 Ouverture d'un compte bancaire",
      "item": [
        {
          "name": "03.01 Créer compte CHEQUING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('response body exists', function () {",
                  "  pm.expect(pm.response.text()).to.not.equal(undefined);",
                  "});",
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (data.account_id) pm.collectionVariables.set('account_id', String(data.account_id));",
                  "let req = {};",
                  "try { req = JSON.parse(pm.request.body.raw || '{}'); } catch (e) {}",
                  "if (req.customer_id) pm.collectionVariables.set('account_customer_id', String(req.customer_id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{account_customer_id}}\",\n  \"account_type\": \"CHEQUING\",\n  \"initial_balance\": 1000\n}"
            },
