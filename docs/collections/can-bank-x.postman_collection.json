  "item": [
    {
      "name": "CU-01 Inscription & Verification d'identite (KYC)",
      "item": [
        {
          "name": "01.01 Ouvrir Page Inscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status registration page', function () {",
                  "  pm.expect([200, 302, 303]).to.include(pm.response.code);",
                  "});",
                  "pm.test('registration form is present', function () {",
                  "  pm.expect(pm.response.text()).to.include('kc-register-form');",
                  "});",
                  "pm.test('response exists', function () {",
                  "  pm.expect(pm.response.text()).to.not.equal(undefined);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "http://localhost:8082/realms/can-bank-x/protocol/openid-connect/token",
                  "type": "string"
                },
                {
                  "key": "authUrl",
                  "value": "http://localhost:8082/realms/can-bank-x/protocol/openid-connect/auth",
                  "type": "string"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code_with_pkce",
                  "type": "string"
                },
                {
                  "key": "clientId",
                  "value": "can-bank-x-api",
                  "type": "string"
                },
                {
                  "key": "useBrowser",
                  "value": false,
                  "type": "boolean"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://oauth.pstmn.io/v1/callback",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{gateway_base_url}}/realms/{{realm}}/protocol/openid-connect/registrations?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type=code&scope=openid%20profile%20email&kc_action=register",
              "host": [
                "{{gateway_base_url}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "registrations"
