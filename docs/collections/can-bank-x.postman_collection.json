                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "scope",
                  "value": "openid%20profile%20email"
                },
                {
                  "key": "kc_action",
                  "value": "register"
                }
              ]
            }
          },
          "response": []
        }
      ]
