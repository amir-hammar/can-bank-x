        {
          "name": "02.02 Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 or 404', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 404) {",
                  "  pm.test('response body exists', function () {",
                  "    pm.expect(pm.response.text()).to.not.equal(undefined);",
                  "  });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "  let data = {};",
                  "  try { data = pm.response.json(); } catch (e) {}",
                  "  if (data.id) pm.collectionVariables.set('client_profile_id', String(data.id));",
                  "  if (data.username) pm.collectionVariables.set('account_customer_id', String(data.username));",
                  "}"
