        {
          "name": "02.02 Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 or 404', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 404) {",
                  "  pm.test('response body exists', function () {",
                  "    pm.expect(pm.response.text()).to.not.equal(undefined);",
                  "  });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "  let data = {};",
                  "  try { data = pm.response.json(); } catch (e) {}",
                  "  if (data.id) pm.collectionVariables.set('client_profile_id', String(data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              }
            ],
            "url": {
              "raw": "{{gateway_base_url}}/api/v1/customers/me",
              "host": [
                "{{gateway_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02.03 Get KYC Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 or 404', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 404) {",
                  "  pm.test('response body exists', function () {",
                  "    pm.expect(pm.response.text()).to.not.equal(undefined);",
                  "  });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "  let data = {};",
                  "  try { data = pm.response.json(); } catch (e) {}",
                  "  if (data.kyc_id) pm.collectionVariables.set('kyc_id', String(data.kyc_id));",
                  "}"
                ],
