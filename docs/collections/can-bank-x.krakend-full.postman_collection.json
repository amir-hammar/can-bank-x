{
  "info": {
    "name": "can-bank-x KrakenD Full Coverage",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_base", "value": "http://localhost:8080", "type": "string" },
    { "key": "keycloak_base", "value": "http://localhost:8082", "type": "string" },
    { "key": "realm", "value": "can-bank-x", "type": "string" },
    { "key": "client_id", "value": "can-bank-x-api", "type": "string" },
    { "key": "keycloak_admin", "value": "admin", "type": "string" },
    { "key": "keycloak_admin_password", "value": "admin", "type": "string" },
    { "key": "username", "value": "demo.customer", "type": "string" },
    { "key": "password", "value": "Passw0rd!", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Keycloak OTP",
      "item": [
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonData = pm.response.json();",
                  "  pm.collectionVariables.set('admin_token', jsonData.access_token || '');",
                  "}",
                  "pm.test('admin token request success', function () { pm.expect(pm.response.code).to.eql(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "admin-cli" },
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "{{keycloak_admin}}" },
                { "key": "password", "value": "{{keycloak_admin_password}}" }
              ]
            },
            "url": "{{keycloak_base}}/realms/master/protocol/openid-connect/token"
          }
        },
        {
          "name": "Validate Password Policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('realm fetch success', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json();",
                  "const policy = data.passwordPolicy || '';",
                  "pm.test('has length(12)', function () { pm.expect(policy).to.include('length(12)'); });",
                  "pm.test('has notEmail', function () { pm.expect(policy).to.include('notEmail'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{keycloak_base}}/admin/realms/{{realm}}"
          }
        },
        {
          "name": "Validate CONFIGURE_TOTP Required Action",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('required actions fetch success', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const actions = pm.response.json();",
                  "const target = actions.find(a => a.alias === 'CONFIGURE_TOTP');",
                  "pm.test('CONFIGURE_TOTP exists', function () { pm.expect(!!target).to.eql(true); });",
                  "pm.test('CONFIGURE_TOTP default action', function () { pm.expect(target.defaultAction).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{keycloak_base}}/admin/realms/{{realm}}/authentication/required-actions"
          }
        },
        {
          "name": "Get User Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonData = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', jsonData.access_token || '');",
                  "}",
                  "pm.test('user token request success', function () { pm.expect(pm.response.code).to.eql(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "scope", "value": "openid profile email" }
              ]
            },
            "url": "{{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "KrakenD Endpoints",
      "item": [
        { "name": "GET /health", "request": { "method": "GET", "url": "{{gateway_base}}/health" } },
        { "name": "GET /auth/realms/.../auth", "request": { "method": "GET", "url": "{{gateway_base}}/auth/realms/{{realm}}/protocol/openid-connect/auth?client_id={{client_id}}&redirect_uri=http://localhost:8083/callback&response_type=code&scope=openid+profile+email" } },
        { "name": "GET /auth/realms/.../registrations", "request": { "method": "GET", "url": "{{gateway_base}}/auth/realms/{{realm}}/protocol/openid-connect/registrations" } },
        { "name": "GET /realms/.../auth", "request": { "method": "GET", "url": "{{gateway_base}}/realms/{{realm}}/protocol/openid-connect/auth?client_id={{client_id}}&redirect_uri=http://localhost:8083/callback&response_type=code&scope=openid+profile+email" } },
        { "name": "GET /realms/.../registrations", "request": { "method": "GET", "url": "{{gateway_base}}/realms/{{realm}}/protocol/openid-connect/registrations" } },
        { "name": "GET /realms/.../login-actions/{path}", "request": { "method": "GET", "url": "{{gateway_base}}/realms/{{realm}}/login-actions/authenticate" } },
        { "name": "POST /realms/.../login-actions/{path}", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{gateway_base}}/realms/{{realm}}/login-actions/authenticate" } },
        { "name": "GET /auth/realms/.../login-actions/{path}", "request": { "method": "GET", "url": "{{gateway_base}}/auth/realms/{{realm}}/login-actions/authenticate" } },
        { "name": "POST /auth/realms/.../login-actions/{path}", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{gateway_base}}/auth/realms/{{realm}}/login-actions/authenticate" } },
        { "name": "GET /resources/{a}/{b}/{c}/{d}/{e}", "request": { "method": "GET", "url": "{{gateway_base}}/resources/can-bank-x/login/resources/js/canbankx-theme.js" } },
        { "name": "GET /resources/{a}/{b}/{c}/{d}/{e}/{f}", "request": { "method": "GET", "url": "{{gateway_base}}/resources/can-bank-x/login/resources/js/canbankx-theme.js/x" } },
        { "name": "GET /resources/{a}/{b}/{c}/{d}/{e}/{f}/{g}", "request": { "method": "GET", "url": "{{gateway_base}}/resources/can-bank-x/login/resources/js/canbankx-theme.js/x/y" } },
        { "name": "POST /auth/realms/.../token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }], "body": { "mode": "urlencoded", "urlencoded": [{ "key": "client_id", "value": "{{client_id}}" }, { "key": "grant_type", "value": "password" }, { "key": "username", "value": "{{username}}" }, { "key": "password", "value": "{{password}}" }] }, "url": "{{gateway_base}}/auth/realms/{{realm}}/protocol/openid-connect/token" } },
        { "name": "GET /auth/realms/.../certs", "request": { "method": "GET", "url": "{{gateway_base}}/auth/realms/{{realm}}/protocol/openid-connect/certs" } },
        { "name": "GET /api/v1/auth/me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{gateway_base}}/api/v1/auth/me" } },
        { "name": "POST /api/v1/customers/register", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.gateway@example.com\",\n  \"full_name\": \"Postman Gateway\",\n  \"street\": \"100 Main\",\n  \"city\": \"Montreal\",\n  \"province\": \"QC\",\n  \"postal_code\": \"H2X 1Z5\",\n  \"country\": \"Canada\",\n  \"nas\": \"123456789\"\n}" }, "url": "{{gateway_base}}/api/v1/customers/register" } },
        { "name": "GET /api/v1/customers/{path}", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{gateway_base}}/api/v1/customers/me" } },
        { "name": "GET /api/v1/kyc/{path}", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{gateway_base}}/api/v1/kyc/status" } },
        { "name": "GET /api/v1/accounts/{path}", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{gateway_base}}/api/v1/accounts/me" } },
        { "name": "POST /api/v1/transfers/create", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"from_account_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"to_account_id\": \"00000000-0000-0000-0000-000000000002\",\n  \"amount\": 1.00,\n  \"currency\": \"CAD\"\n}" }, "url": "{{gateway_base}}/api/v1/transfers/create" } },
        { "name": "GET /api/v1/transfers/{path}", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{gateway_base}}/api/v1/transfers/status" } }
      ]
    }
  ]
}
