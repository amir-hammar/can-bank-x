@startuml Diagramme de composants
title CanBankX - Diagramme de composants (Architecture avec NGINX Load Balancer)
skinparam componentStyle rectangle

actor "Client API" as Client

component "API Gateway\n(KrakenD :8080)" as GW
component "NGINX Load Balancer\n(internal :8080)" as LB

package "User Service" {
    component "User API\n/auth, /customers, /kyc" as UserAPI
    component "CustomerService" as CustomerSvc
    component "KycService" as KycSvc
    component "CustomerRepository" as CustomerRepo
    component "KycRepository" as KycRepo
    component "AuditRepository" as UserAudit
    component "KycMockService" as KycMock
}

package "Account Service" {
    component "Account API\n/accounts, /balance, /default, /apply-transfer" as AccountAPI
    component "AccountService" as AccountSvc
    component "AccountRepository" as AccountRepo
    component "AuditRepository" as AccountAudit
    component "Account Cache" as AccountCache
}

package "Transfer Service" {
    component "Transfer API\n/transfers" as TransferAPI
    component "TransferService" as TransferSvc
    component "TransferRepository" as TransferRepo
    component "Transfer Cache" as TransferCache
    component "AuditRepository" as TransferAudit
}

database "PostgreSQL\n(canbankx_user)" as DBUser
database "PostgreSQL\n(canbankx_account)" as DBAccount
database "PostgreSQL\n(canbankx_transfer)" as DBTransfer
component "Redis" as Redis
component "Prometheus" as Prom
component "Grafana" as Grafana
component "Keycloak" as Keycloak

Client --> GW : HTTP :8080
GW --> LB : routing + auth validation

LB --> UserAPI : /customers /auth /kyc\n(least_conn LB)
LB --> AccountAPI : /accounts\n(least_conn LB)
LB --> TransferAPI : /transfers\n(least_conn LB)

GW --> Keycloak : JWT validation

UserAPI --> CustomerSvc
UserAPI --> KycSvc
CustomerSvc --> CustomerRepo
KycSvc --> KycRepo
KycSvc --> KycMock
KycSvc --> UserAudit
CustomerRepo --> DBUser
KycRepo --> DBUser
UserAudit --> DBUser

AccountAPI --> AccountSvc
AccountSvc --> AccountRepo
AccountSvc --> AccountAudit
AccountSvc --> AccountCache
AccountRepo --> DBAccount
AccountAudit --> DBAccount
AccountCache --> Redis

TransferAPI --> TransferSvc
TransferSvc --> TransferRepo
TransferSvc --> TransferCache
TransferSvc --> TransferAudit
TransferSvc -.-> UserAPI : HTTP calls
TransferSvc -.-> AccountAPI : HTTP calls
TransferRepo --> DBTransfer
TransferAudit --> DBTransfer
TransferCache --> Redis

UserAPI --> Prom : metrics
AccountAPI --> Prom : metrics
TransferAPI --> Prom : metrics
GW --> Prom : metrics
Prom --> Grafana
@enduml