@startuml Diagramme de déploiement
title Déploiement CanBankX

actor "Client externe" as Client

node "Hôte Docker" as Host {
    node "Réseau Docker\ncan-bank-x-network" as Net {
        node "api-gateway\nKrakenD :8080\n(hôte 8080)" as GW <<container>>
        node "nginx-load-balancer\nNGINX :8080" as LB <<container>>
        node "user-service\nRust/Axum :8080\nx1..xN réplicas" as US <<container>>
        node "account-service\nRust/Axum :8080\nx1..xN réplicas" as AS <<container>>
        node "transfer-service\nRust/Axum :8080\nx1..xN réplicas" as TS <<container>>
        node "keycloak\nOIDC/JWT :8080\n(hôte 8082)" as KC <<container>>
        database "postgres\ncanbankx_user\ncanbankx_account\ncanbankx_transfer" as DB <<container>>
        node "redis\nCache :6379" as RC <<container>>
        node "prometheus\nMetrics :9090" as PR <<container>>
        node "grafana\nDashboards :3000\n(hôte 3001)" as GF <<container>>
        node "postgres-exporter\n:9187" as PE <<container>>
        node "node-exporter\n:9100" as NE <<container>>
        node "cadvisor\n:8080" as CV <<container>>
    }
}

Client --> GW : HTTP :8080 (entry point)
GW --> LB : Routing + Auth validation\n(KrakenD → NGINX)
LB --> US : /api/v1/customers\n/api/v1/auth\n/api/v1/kyc
LB --> AS : /api/v1/accounts
LB --> TS : /api/v1/transfers
GW --> KC : Keycloak JWT validation

US --> DB : SQL Query\n(canbankx_user)
AS --> DB : SQL Query\n(canbankx_account)
AS --> RC : Cache layer
TS --> DB : SQL Query\n(canbankx_transfer)
TS --> RC : Cache layer
TS -.-> US : Inter-service call\n(HTTP)
TS -.-> AS : Inter-service call\n(HTTP)

PR --> GW : scrape /metrics
PR --> US : scrape /metrics
PR --> AS : scrape /metrics
PR --> TS : scrape /metrics
PR --> KC : scrape /metrics
PR --> PE : scrape
PR --> NE : scrape
PR --> CV : scrape
GF --> PR : Query metrics\nfor dashboards

note right of LB
  Load balancing par service:
  - least_conn algorithm
  - Health checks
  - Failover support
end note

note right of GW
  API Gateway:
  - Routing
  - Authentication
  - CORS
  - Rate limiting
end note
@enduml