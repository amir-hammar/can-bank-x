@startuml Diagramme de déploiement
title Déploiement CanBankX (Docker Compose)

actor "Client externe" as Client

node "Hôte Docker" as Host {
    node "Réseau Docker\ncan-bank-x-network" as Net {
        node "edge-load-balancer\nNGINX :8080" as LB <<container>>
        node "api-gateway\nKrakenD :8080\nx1..x4 réplicas" as GW <<container>>
        node "user-service\nRust/Axum :8080" as US <<container>>
        node "account-service\nRust/Axum :8080" as AS <<container>>
        node "transfer-service\nRust/Axum :8080" as TS <<container>>
        node "keycloak\nOIDC/JWT :8080 (hôte 8082)" as KC <<container>>
        database "postgres\ncanbankx_user\ncanbankx_account\ncanbankx_transfer" as DB <<container>>
        node "redis :6379" as RC <<container>>
        node "prometheus :9090" as PR <<container>>
        node "grafana :3000 (hôte 3001)" as GF <<container>>
        node "postgres-exporter :9187" as PE <<container>>
        node "node-exporter :9100" as NE <<container>>
        node "cadvisor :8080" as CV <<container>>
    }
}

Client --> LB : HTTP :8080
LB --> GW : Reverse proxy / load balancing
GW --> US : API User/KYC
GW --> AS : API Account
GW --> TS : API Transfer
GW --> KC : Validation JWT (JWK)

US --> DB : SQL (canbankx_user)
AS --> DB : SQL (canbankx_account)
TS --> DB : SQL (canbankx_transfer)
AS --> RC : Cache
TS --> RC : Cache

PR --> US : scrape /metrics
PR --> AS : scrape /metrics
PR --> TS : scrape /metrics
PR --> GW : scrape /metrics
PR --> KC : scrape /metrics
PR --> PE : scrape
PR --> NE : scrape
PR --> CV : scrape
GF --> PR : Query dashboards
@enduml