{
  "realm": "can-bank-x",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notEmail",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "loginTheme": "can-bank-x",
  "accountTheme": "can-bank-x",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "clients": [
    {
      "clientId": "can-bank-x-api",
      "name": "can-bank-x-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8083/*",
        "http://localhost:8083/callback"
      ],
      "webOrigins": [
        "http://localhost:8083"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "demo.customer",
      "enabled": true,
      "email": "demo.customer@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "Passw0rd!",
          "temporary": false
        }
      ],
      "requiredActions": []
    }
  ]
}
