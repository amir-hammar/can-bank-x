POSTGRES_USER=canbankx_user
POSTGRES_PASSWORD=canbankx_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password
USER_SERVICE_DATABASE_URL=postgresql://canbankx_user:canbankx_password@postgres:5432/canbankx_user
ACCOUNT_SERVICE_DATABASE_URL=postgresql://canbankx_user:canbankx_password@postgres:5432/canbankx_account
TRANSFER_SERVICE_DATABASE_URL=postgresql://canbankx_user:canbankx_password@postgres:5432/canbankx_transfer

# Set to true to enable Redis caching for account service and transfer service
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
REDIS_URL=redis://redis:6379