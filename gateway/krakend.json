        "Authorization",
        "Content-Type",
        "Accept",
        "X-Trace-Id",
        "X-Request-Id"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "security/http": {
      "content_type_nosniff": true,
      "frame_deny": true,
      "browser_xss_filter": true,
      "sts_seconds": 31536000
    }
