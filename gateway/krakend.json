{
  "version": 3,
  "name": "can-bank-x-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "router": {
      "return_error_msg": true,
      "auto_options": true
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[gateway]",
      "stdout": true
    },
    "github.com/devopsfaith/krakend-cors": {
      "allow_origins": [
        "http://localhost:8083"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "Accept",
        "X-Trace-Id",
        "X-Request-Id"
      ],
      "expose_headers": [],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:8083"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
