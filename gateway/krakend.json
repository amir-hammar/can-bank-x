{
  "version": 3,
  "name": "can-bank-x-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[gateway]",
      "stdout": true
    },
    "github.com/devopsfaith/krakend-cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": [
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "security/http": {
      "content_type_nosniff": true,
      "frame_deny": true,
      "browser_xss_filter": true,
      "sts_seconds": 31536000
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/{path:.*}",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "host": ["http://user-service:80"],
          "url_pattern": "/api/v1/auth/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/customers/register",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 5,
          "capacity": 10
        }
      },
      "backend": [
        {
          "host": ["http://user-service:80"],
          "url_pattern": "/api/v1/customers/register"
        }
      ]
    },
    {
      "endpoint": "/api/v1/customers/{path:.*}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://keycloak:8080/realms/can-bank-x",
          "audience": ["can-bank-x-api"],
          "disable_jwk_security": true
        }
      },
      "backend": [
        {
          "host": ["http://user-service:80"],
          "url_pattern": "/api/v1/customers/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/kyc/{path:.*}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://keycloak:8080/realms/can-bank-x",
          "audience": ["can-bank-x-api"],
          "disable_jwk_security": true
        }
      },
      "backend": [
        {
          "host": ["http://user-service:80"],
          "url_pattern": "/api/v1/kyc/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/accounts/{path:.*}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://keycloak:8080/realms/can-bank-x",
          "audience": ["can-bank-x-api"],
          "disable_jwk_security": true
        }
      },
      "backend": [
        {
          "host": ["http://account-service:8080"],
          "url_pattern": "/api/v1/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/transfers/{path:.*}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://keycloak:8080/realms/can-bank-x",
          "audience": ["can-bank-x-api"],
          "disable_jwk_security": true
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 40
        }
      },
      "backend": [
        {
          "host": ["http://transfer-service:80"],
          "url_pattern": "/api/v1/transfers/{path}"
        }
      ]
    }
  ]
}