{
  "version": 3,
  "name": "can-bank-x-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[gateway]",
      "stdout": true
    },
    "github.com/devopsfaith/krakend-cors": {
      "allow_origins": ["http://localhost:8083"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": [
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "security/http": {
      "content_type_nosniff": true,
      "frame_deny": true,
      "browser_xss_filter": true,
      "sts_seconds": 31536000
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["X-Trace-Id", "X-Request-Id"],
      "backend": [
        {
          "host": ["http://user-service:8080"],
          "url_pattern": "/health"
        }
      ]
    },
    {
      "endpoint": "/auth/realms/can-bank-x/protocol/openid-connect/auth",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["*"],
      "input_headers": ["*"],
      "backend": [
        {
          "host": ["http://keycloak:8080"],
          "url_pattern": "/realms/can-bank-x/protocol/openid-connect/auth",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/auth/realms/can-bank-x/protocol/openid-connect/token",
      "method": "POST",
      "output_encoding": "no-op",
      "input_query_strings": ["*"],
      "input_headers": ["*"],
      "backend": [
        {
          "host": ["http://keycloak:8080"],
          "url_pattern": "/realms/can-bank-x/protocol/openid-connect/token",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/auth/realms/can-bank-x/protocol/openid-connect/certs",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://keycloak:8080"],
          "url_pattern": "/realms/can-bank-x/protocol/openid-connect/certs",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/me",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type", "X-Trace-Id", "X-Request-Id", "x-user-sub"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        }
      },
      "backend": [
        {
          "host": ["http://user-service:8080"],
          "url_pattern": "/api/v1/auth/me"
        }
      ]
    },
    {
      "endpoint": "/api/v1/customers/register",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type", "X-Trace-Id", "X-Request-Id"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        },
        "qos/ratelimit/router": {
          "max_rate": 5,
          "capacity": 10
        }
      },
      "backend": [
        {
          "host": ["http://user-service:8080"],
          "url_pattern": "/api/v1/customers/register"
        }
      ]
    },
    {
      "endpoint": "/api/v1/customers/{path}",
      "input_headers": ["Authorization", "Content-Type", "X-Trace-Id", "X-Request-Id"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        }
      },
      "backend": [
        {
          "host": ["http://user-service:8080"],
          "url_pattern": "/api/v1/customers/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/kyc/{path}",
      "input_headers": ["Authorization", "Content-Type", "X-Trace-Id", "X-Request-Id"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        },
        "qos/ratelimit/router": {
          "max_rate": 10,
          "capacity": 20
        }
      },
      "backend": [
        {
          "host": ["http://user-service:8080"],
          "url_pattern": "/api/v1/kyc/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/accounts/{path}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        }
      },
      "backend": [
        {
          "host": ["http://account-service:80"],
          "url_pattern": "/api/v1/{path}"
        }
      ]
    },
    {
      "endpoint": "/api/v1/transfers/create",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 40
        }
      },
      "backend": [
        {
          "host": ["http://transfer-service:8080"],
          "url_pattern": "/api/v1/transfers/create"
        }
      ]
    },
    {
      "endpoint": "/api/v1/transfers/{path}",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "github.com/devopsfaith/krakend-jose/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/can-bank-x/protocol/openid-connect/certs",
          "issuer": "http://localhost:8082/realms/can-bank-x",
          "disable_jwk_security": true,
          "propagate_claims": [["sub", "X-User-Sub"]]
        },
        "qos/ratelimit/router": {
          "max_rate": 20,
          "capacity": 40
        }
      },
      "backend": [
        {
          "host": ["http://transfer-service:8080"],
          "url_pattern": "/api/v1/transfers/{path}"
        }
      ]
    }
  ]
}