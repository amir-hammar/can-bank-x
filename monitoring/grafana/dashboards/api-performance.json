{
  "id": null,
  "uid": "canbankx-api-performance",
  "title": "CanBankX - API Performance",
  "tags": ["canbankx", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate by Job (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "{{job}} (http_requests_total)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (job)",
          "legendFormat": "{{job}} (http_server_requests_seconds_count)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency by Job (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} (http_request_duration)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{job}} (http_server_requests)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "4xx/5xx Rate by Job",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gateway Up",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "max(up{job=\"api-gateway\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "User Service Up",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "max(up{job=\"user-service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Network Throughput (bytes/s)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{name!~\"\"}[5m])) by (name)",
          "legendFormat": "{{name}} rx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{name!~\"\"}[5m])) by (name)",
          "legendFormat": "{{name}} tx",
          "refId": "B"
        }
      ]
    }
  ]
}
