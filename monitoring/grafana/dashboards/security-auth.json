{
  "id": null,
  "uid": "canbankx-security-auth",
  "title": "CanBankX - Security and Auth",
  "tags": ["canbankx", "security", "auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Keycloak Up",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "max(up{job=\"keycloak\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gateway Up",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "max(up{job=\"api-gateway\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "401 Rate (req/s)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=\"401\"}[5m])) + sum(rate(http_server_requests_seconds_count{status=\"401\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "403 Rate (req/s)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=\"403\"}[5m])) + sum(rate(http_server_requests_seconds_count{status=\"403\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Auth Errors by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"401|403|429\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"401|403|429\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Login/Token Activity",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(keycloak_logins[5m])) by (realm)",
          "legendFormat": "keycloak logins {{realm}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(canbankx_auth_token_requests_total[5m])) or vector(0)",
          "legendFormat": "token requests/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JWT Validation Failures",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(canbankx_jwt_validation_failures_total[5m])) by (reason) or vector(0)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=\"429\"}[5m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[5m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "B"
        }
      ]
    }
  ]
}
